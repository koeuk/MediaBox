{$DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
    }

    @api path /api /api/*
    handle @api {
        reverse_proxy backend:8000 {
            flush_interval -1
        }
    }

    handle {
        reverse_proxy frontend:3000
    }
}
