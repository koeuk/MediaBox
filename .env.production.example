# Public hostname only, without https:// or a trailing slash.
DOMAIN=droplinks.site

# Existing deployment: use its current SECRET_KEY and MySQL root password.
# New deployment: generate each separately with: openssl rand -hex 32
# Keep existing passwords unchanged. Single-quote values containing $ or #.
# DB_PASSWORD is passed separately, so URL special characters are supported.
SECRET_KEY=
DB_PASSWORD=

# Gmail: use your Gmail address in both fields and a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_FROM_EMAIL=
SMTP_PASSWORD=
PASSWORD_RESET_EXPIRE_MINUTES=30

MAX_CONCURRENT_DOWNLOADS=3
MAX_DOWNLOAD_SIZE_MB=2048

STORAGE_BACKEND=spaces
# Production Compose enforces APP_ENV=production; local development defaults to dev.
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=sgp1
DO_SPACES_BUCKET=droplinks-uploads
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
