# Copy to .env and adjust
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./mediabox.db
# DATABASE_URL=postgresql+psycopg2://mediabox:mediabox@localhost:5432/mediabox
# MySQL — charset=utf8mb4 is required so emoji/Khmer titles survive:
# DATABASE_URL=mysql+pymysql://mediabox:mediabox@127.0.0.1:3306/mediabox?charset=utf8mb4
MEDIA_DIR=./media
CORS_ORIGINS=http://localhost:3000
MAX_DOWNLOAD_SIZE_MB=2048
# Worker threads for downloads/conversions; queued jobs wait their turn
MAX_CONCURRENT_DOWNLOADS=3
# Sites whose page links are resolved with yt-dlp (subdomains included).
# Only download content you own or are authorized to save.
YTDLP_HOSTS=tiktok.com,facebook.com,fb.watch,youtube.com,youtu.be
# Optional: path to a Netscape-format cookies.txt (exported from your browser)
# for videos that require login, e.g. age-restricted TikTok posts
# YTDLP_COOKIES_FILE=/path/to/cookies.txt
# Allow downloading from localhost / private-network URLs (dev only)
ALLOW_PRIVATE_URLS=false
