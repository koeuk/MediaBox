# Copy to .env and adjust
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./mediabox.db
# DATABASE_URL=postgresql+psycopg2://mediabox:mediabox@localhost:5432/mediabox
# MySQL — charset=utf8mb4 is required so emoji/Khmer titles survive:
# DATABASE_URL=mysql+pymysql://mediabox:mediabox@127.0.0.1:3306/mediabox?charset=utf8mb4
# For local access to server MySQL, set DATABASE_URL to 127.0.0.1:13306
# and enable the SSH tunnel below. dev.sh opens it automatically.
# DATABASE_SSH_HOST=user@your-server
MEDIA_DIR=./media
CORS_ORIGINS=http://localhost:3000
MAX_DOWNLOAD_SIZE_MB=2048
# Worker threads for downloads/conversions; queued jobs wait their turn
MAX_CONCURRENT_DOWNLOADS=3
# Sites whose page links are resolved with yt-dlp (subdomains included).
# Only download content you own or are authorized to save.
YTDLP_HOSTS=tiktok.com,facebook.com,fb.watch,youtube.com,youtu.be,pornhub.com,instagram.com
# Optional: path to a Netscape-format cookies.txt (exported from your browser)
# for videos that require login, e.g. Instagram reels or age-restricted TikTok posts
# YTDLP_COOKIES_FILE=/path/to/cookies.txt
# Allow downloading from localhost / private-network URLs (dev only)
ALLOW_PRIVATE_URLS=false


# Where downloaded/converted videos are stored on this computer.
MEDIA_DIR=./media

# MySQL — charset=utf8mb4 keeps emoji / Khmer titles intact
DATABASE_URL="mysql+pymysql://koeuk:k@188.166.208.140:3306/mediabox"

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mediabox
DB_USERNAME=root
DB_PASSWORD=koeuk

# PostgreSQL / Prisma URL format
DATABASE_URL="postgresql://koeuk:k@188.166.208.140:5432/mediabox?schema=public"
